SMTP_HOST=YOUR_HOST
SMTP_PORT=YOUR_PORT
SMTP_USER=YOUR_USER
SMTP_PASSWORD=YOUR_PASSWORD

NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
# Secret key of the same Turnstile widget (Cloudflare dashboard). Server-side
# only. Without it, tokens from /mitmachen are not verified.
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# --- Blog / Firebase (server-side, Firebase Admin SDK) ---
# From your Firebase service account JSON. To switch from the test project to
# the client's project, just replace these three values.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
# Keep the literal \n escapes from the JSON; wrap the whole value in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
# Private bucket for uploads from /mitmachen (parental consent files), e.g.
# YOUR_PROJECT.firebasestorage.app. The service account above needs the role
# "Storage Object Admin" on it. Without it, minors cannot apply.
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app

# --- CMS admin login ---
ADMIN_PASSWORD=choose-a-strong-password
# Random secret used to sign the admin session cookie (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
# --- Videos from the Swibble app (optional) ---
# HTTPS URL of the app's `websiteVideoApi` Cloud Function and the shared key
# (same value as the app's WEBSITE_VIDEO_API_KEY secret, at least 32 characters).
# Server-side only: never prefix these with NEXT_PUBLIC_.
SWIBBLE_APP_VIDEO_API_URL=https://europe-west3-YOUR_APP_PROJECT.cloudfunctions.net/websiteVideoApi
SWIBBLE_APP_VIDEO_API_KEY=replace-with-the-shared-key

# --- Local development only ---
# Keeps applications from /mitmachen in memory instead of Firestore, so the form
# and /admin/bewerbungen can be tried without Firebase. Ignored in production.
# APPLICATIONS_DEV_STORE=memory
